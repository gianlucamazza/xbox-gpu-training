{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gianlucamazza/floppylm/schemas/floppylm.e0.common.v1.json",
  "title": "Shared definitions for floppylm E0 contracts",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "descriptor": {
      "description": "A content-addressed file: path relative to the job root, size and SHA-256. A freshly uploaded asset also lists the content-addressed chunks it was sent in.",
      "type": "object",
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "$ref": "#/$defs/count"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "chunks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}\\.chunk$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "config": {
      "description": "GPTConfig.to_dict(): every key is required.",
      "type": "object",
      "required": [
        "vocab",
        "d",
        "n_layers",
        "n_heads",
        "d_ff",
        "mlp",
        "core_fmt",
        "emb_fmt",
        "scale_policy",
        "delta",
        "qk_norm",
        "ctx"
      ],
      "properties": {
        "vocab": {
          "type": "integer",
          "minimum": 1
        },
        "d": {
          "type": "integer",
          "minimum": 1
        },
        "n_layers": {
          "type": "integer",
          "minimum": 1
        },
        "n_heads": {
          "type": "integer",
          "minimum": 1
        },
        "d_ff": {
          "type": "integer",
          "minimum": 1
        },
        "mlp": {
          "enum": [
            "gelu",
            "relu2",
            "swiglu"
          ]
        },
        "core_fmt": {
          "enum": [
            "ternary",
            "2bit",
            "4bit"
          ]
        },
        "emb_fmt": {
          "enum": [
            "ternary",
            "2bit",
            "4bit"
          ]
        },
        "scale_policy": {
          "enum": [
            "row16",
            "row8log",
            "tensor16"
          ]
        },
        "delta": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "qk_norm": {
          "type": "boolean"
        },
        "ctx": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "tensor": {
      "description": "One stored tensor, row-major; values has rows * cols entries.",
      "type": "object",
      "required": [
        "name",
        "rows",
        "cols",
        "norm",
        "values"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "cols": {
          "type": "integer",
          "minimum": 1
        },
        "norm": {
          "type": "boolean"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "tensors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tensor"
      },
      "minItems": 1
    },
    "spec": {
      "type": "object",
      "required": [
        "tokens",
        "branches",
        "batch",
        "lr",
        "wd",
        "warmup_frac",
        "cooldown_frac",
        "seed"
      ],
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 1
        },
        "branches": {
          "const": 3
        },
        "batch": {
          "type": "integer",
          "minimum": 1
        },
        "lr": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "wd": {
          "type": "number",
          "minimum": 0
        },
        "warmup_frac": {
          "const": 0.02
        },
        "cooldown_frac": {
          "const": 0.1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "description": "TrainSpec of the three-branch WSD protocol (ADR 0005, ADR 0008)."
    },
    "values": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "named_values": {
      "type": "object",
      "required": [
        "name",
        "values"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "$ref": "#/$defs/values"
        }
      },
      "additionalProperties": false
    },
    "moment": {
      "description": "AdamW first and second moments of one stored tensor.",
      "type": "object",
      "required": [
        "name",
        "first",
        "second"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "first": {
          "$ref": "#/$defs/values"
        },
        "second": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    },
    "moments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/moment"
      },
      "minItems": 1
    },
    "execution": {
      "description": "Execution statistics of one backend report.",
      "type": "object",
      "required": [
        "hardware_gpu",
        "adapter",
        "dispatches",
        "gpu_seconds",
        "transfer_bytes",
        "peak_memory_bytes"
      ],
      "properties": {
        "hardware_gpu": {
          "type": "boolean"
        },
        "adapter": {
          "type": "string"
        },
        "dispatches": {
          "$ref": "#/$defs/count"
        },
        "gpu_seconds": {
          "$ref": "#/$defs/seconds"
        },
        "transfer_bytes": {
          "$ref": "#/$defs/count"
        },
        "peak_memory_bytes": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "gate": {
      "description": "One numerical gate (ADR 0010) or a boolean check.",
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "max_abs": {
          "type": "number"
        },
        "max_rel": {
          "type": "number"
        },
        "max_bound_excess": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/gate"
      },
      "minProperties": 1
    }
  }
}
