{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gianlucamazza/floppylm/schemas/floppylm.e0.constants.v1.json",
  "title": "E0 semantic constants",
  "description": "Constants every implementation of the E0 model, codec and optimizer must share. The published instance is schemas/values/floppylm.e0.constants.v1.json, generated from the floppylm sources. Shape expressions use the config keys vocab, d and d_ff.",
  "type": "object",
  "required": [
    "schema",
    "codec",
    "model",
    "optimizer",
    "schedule"
  ],
  "properties": {
    "schema": {
      "const": "floppylm.e0.constants.v1"
    },
    "codec": {
      "type": "object",
      "required": [
        "formats",
        "scale_policies",
        "fp16_min",
        "fp16_max",
        "log_steps_per_octave",
        "mult_2bit",
        "mult_4bit"
      ],
      "properties": {
        "formats": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "scale_policies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "fp16_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fp16_max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "log_steps_per_octave": {
          "type": "integer",
          "minimum": 1
        },
        "mult_2bit": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mult_4bit": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": [
        "mlps",
        "rope_theta",
        "rmsnorm_eps",
        "gelu_approximate",
        "tensor_layout"
      ],
      "properties": {
        "mlps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "rope_theta": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rmsnorm_eps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gelu_approximate": {
          "enum": [
            "none",
            "tanh"
          ]
        },
        "tensor_layout": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "rows",
              "cols",
              "norm",
              "per_block"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "rows": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^(1|[0-9]+\\*)?(vocab|d|d_ff)$|^1$"
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^(1|[0-9]+\\*)?(vocab|d|d_ff)$|^1$"
                    },
                    "minProperties": 1
                  }
                ]
              },
              "cols": {
                "type": "string",
                "pattern": "^(1|[0-9]+\\*)?(vocab|d|d_ff)$|^1$"
              },
              "norm": {
                "type": "boolean"
              },
              "per_block": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "optimizer": {
      "type": "object",
      "required": [
        "adamw_betas",
        "adamw_eps",
        "grad_clip",
        "grad_clip_eps"
      ],
      "properties": {
        "adamw_betas": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "adamw_eps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "grad_clip": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "grad_clip_eps": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "required": [
        "branches",
        "warmup_frac",
        "cooldown_frac"
      ],
      "properties": {
        "branches": {
          "type": "integer",
          "minimum": 1
        },
        "warmup_frac": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "cooldown_frac": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
