{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gianlucamazza/floppylm/schemas/floppylm.e0.job.v1.json",
  "title": "E0 training job (host to native backend)",
  "description": "A training job. Produced by floppylm_xbox.jobs.prepare_job; submission adds purpose and acceptance_sha256, resumption adds resume and drops stop_after. It requires the three-branch WSD protocol.",
  "type": "object",
  "required": [
    "schema",
    "job_id",
    "config",
    "spec",
    "initialization",
    "data",
    "indices"
  ],
  "properties": {
    "schema": {
      "const": "floppylm.e0.job.v1"
    },
    "job_id": {
      "$ref": "floppylm.e0.common.v1.json#/$defs/job_id"
    },
    "config": {
      "$ref": "floppylm.e0.common.v1.json#/$defs/config"
    },
    "spec": {
      "$ref": "floppylm.e0.common.v1.json#/$defs/spec"
    },
    "initialization": {
      "$ref": "floppylm.e0.common.v1.json#/$defs/descriptor"
    },
    "data": {
      "$ref": "floppylm.e0.common.v1.json#/$defs/descriptor"
    },
    "indices": {
      "$ref": "floppylm.e0.common.v1.json#/$defs/descriptor"
    },
    "purpose": {
      "enum": [
        "functional",
        "scientific"
      ]
    },
    "acceptance_sha256": {
      "$ref": "floppylm.e0.common.v1.json#/$defs/sha256"
    },
    "resume": {
      "$ref": "floppylm.e0.common.v1.json#/$defs/descriptor"
    },
    "stop_after": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
