{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gianlucamazza/floppylm/schemas/floppylm.checkpoint.v1.json",
  "title": "E0 trunk checkpoint",
  "description": "Trunk state that resumes a job exactly: it repeats the bound job fields, the optimizer step, the data-stream position (step x batch), master tensors and AdamW moments. Sent back to the backend as the job's resume asset.",
  "type": "object",
  "required": [
    "schema",
    "job_id",
    "config",
    "spec",
    "data",
    "indices",
    "step",
    "stream_position",
    "tensors",
    "moments",
    "initialization_sha256"
  ],
  "properties": {
    "schema": {
      "const": "floppylm.checkpoint.v1"
    },
    "job_id": {
      "$ref": "floppylm.e0.common.v1.json#/$defs/job_id"
    },
    "config": {
      "$ref": "floppylm.e0.common.v1.json#/$defs/config"
    },
    "spec": {
      "$ref": "floppylm.e0.common.v1.json#/$defs/spec"
    },
    "data": {
      "$ref": "floppylm.e0.common.v1.json#/$defs/descriptor"
    },
    "indices": {
      "$ref": "floppylm.e0.common.v1.json#/$defs/descriptor"
    },
    "step": {
      "$ref": "floppylm.e0.common.v1.json#/$defs/count"
    },
    "stream_position": {
      "$ref": "floppylm.e0.common.v1.json#/$defs/count"
    },
    "tensors": {
      "$ref": "floppylm.e0.common.v1.json#/$defs/tensors"
    },
    "moments": {
      "$ref": "floppylm.e0.common.v1.json#/$defs/moments"
    },
    "initialization_sha256": {
      "$ref": "floppylm.e0.common.v1.json#/$defs/sha256"
    }
  },
  "additionalProperties": false
}
