{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gianlucamazza/floppylm/schemas/floppylm.claim.v1.json",
  "title": "floppylm.claim.v1",
  "type": "object",
  "required": [
    "schema",
    "worker_id",
    "package",
    "commit",
    "job_id",
    "job_sha256",
    "job_payload"
  ],
  "properties": {
    "schema": {
      "const": "floppylm.claim.v1"
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "package": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "job_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "job_payload": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
