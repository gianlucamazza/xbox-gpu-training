{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gianlucamazza/xbox-gpu-training/examples/qat-wsd.schema.json",
  "title": "xbox-gpu-training.qat.wsd.v1",
  "description": "Fase 5 QAT + WSD schedule. Isolated cooldowns overlay WSD and must not overlap each other. Hand-validated by scripts/validate_qat_schedule.py and the host dry-run (no jsonschema runtime dependency).",
  "type": "object",
  "required": ["schema", "name", "qat", "optimizer", "wsd", "cooldowns", "smoke"],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "type": "string",
      "const": "xbox-gpu-training.qat.wsd.v1"
    },
    "name": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "qat": {
      "type": "object",
      "required": ["master", "bit_width"],
      "properties": {
        "master": { "type": "string", "const": "fp32" },
        "bit_width": { "type": "string", "enum": ["ternary", "2", "4", "2bit", "4bit"] },
        "ste_clip": { "type": "string", "const": "normalized_abs" },
        "scale_grad": { "type": "boolean", "const": false }
      }
    },
    "optimizer": {
      "type": "object",
      "required": ["type", "base_lr", "beta1", "beta2", "eps", "weight_decay"],
      "properties": {
        "type": { "type": "string", "const": "adamw" },
        "base_lr": { "type": "number", "exclusiveMinimum": 0 },
        "beta1": { "type": "number" },
        "beta2": { "type": "number" },
        "eps": { "type": "number", "exclusiveMinimum": 0 },
        "weight_decay": { "type": "number", "minimum": 0 },
        "device": { "type": "string", "const": "host" }
      }
    },
    "wsd": {
      "type": "object",
      "required": ["warmup_steps", "stable_steps", "decay_steps", "decay", "min_lr"],
      "properties": {
        "warmup_steps": { "type": "integer", "minimum": 1 },
        "stable_steps": { "type": "integer", "minimum": 1 },
        "decay_steps": { "type": "integer", "minimum": 1 },
        "decay": { "type": "string", "const": "linear" },
        "min_lr": { "type": "number", "minimum": 0 }
      }
    },
    "cooldowns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start_step", "steps", "end_lr"],
        "properties": {
          "id": { "type": "string" },
          "start_step": { "type": "integer", "minimum": 0 },
          "steps": { "type": "integer", "minimum": 1 },
          "end_lr": { "type": "number", "minimum": 0 }
        }
      }
    },
    "smoke": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "steps": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
